# ── Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (요약 작업이라 low로도 충분)
CLAUDE_EFFORT=low

# ── A 메일 (새 메일을 읽어올 계정, IMAP) ── 네이버 기준 ─────
# 네이버 메일 > 환경설정 > POP3/IMAP 설정 > IMAP/SMTP 사용 "사용함" 필요
IMAP_HOST=imap.naver.com
IMAP_PORT=993
# 네이버 아이디 (@naver.com 없이)
IMAP_USER=myid
# 2단계 인증을 쓰면 일반 비밀번호 대신 "애플리케이션 비밀번호"
IMAP_PASSWORD=your-password
IMAP_MAILBOX=INBOX
# (선택) 조건에 맞는 메일을 복사해 둘 메일 폴더. 비워두면 정리 폴더 기능을 쓰지 않습니다.
ORGANIZE_FOLDER=AI-정리

# ── 요약 메일 발송 (SMTP) ──────────────────────────────────
# A(네이버) 계정의 SMTP로 B 메일에 보냅니다.
SMTP_HOST=smtp.naver.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=myid
SMTP_PASSWORD=your-password
# 비워두면 SMTP_USER + 도메인으로 자동 완성 (myid -> myid@naver.com)
MAIL_FROM=

# ── B 메일 (요약본 받을 주소) ─────────────────────────────
DIGEST_TO=b-account@example.com

# ── 필터 ──────────────────────────────────────────────────
# 송신자 이름 또는 주소에 이 키워드 중 하나라도 포함되면 대상 (쉼표 구분, 대소문자 무시)
SENDER_KEYWORDS=github.com,홍길동,@mycompany.co.kr

# ── 스케줄러 ──────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=10
STATE_FILE=state.json
