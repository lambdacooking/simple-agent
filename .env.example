# ── Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (요약 작업이라 low로도 충분)
CLAUDE_EFFORT=low

# ── A 메일 (새 메일을 읽어올 계정, IMAP) ───────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=a-account@gmail.com
# Gmail은 일반 비밀번호가 아니라 "앱 비밀번호"를 사용해야 합니다.
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX
# (선택) 조건에 맞는 메일을 복사해 둘 폴더/라벨. 비워두면 정리 폴더 기능을 쓰지 않습니다.
ORGANIZE_FOLDER=AI-정리

# ── 요약 메일 발송 (SMTP) ──────────────────────────────────
# 보통 A 계정의 SMTP로 B 메일에 보냅니다.
SMTP_HOST=smtp.gmail.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=a-account@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=a-account@gmail.com

# ── B 메일 (요약본 받을 주소) ─────────────────────────────
DIGEST_TO=b-account@example.com

# ── 필터 ──────────────────────────────────────────────────
# 송신자 이름 또는 주소에 이 키워드 중 하나라도 포함되면 대상 (쉼표 구분, 대소문자 무시)
SENDER_KEYWORDS=github.com,홍길동,@mycompany.co.kr

# ── 스케줄러 ──────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=10
STATE_FILE=state.json
